# MySQL/MariaDB connection string used by Prisma.
DATABASE_URL="mysql://tco_user:changeme@localhost:3306/topic_cluster_organizer"

# Secret used to sign login session JWTs — generate a long random value for real deployments,
# e.g. `openssl rand -hex 32`. Changing it invalidates every existing login session.
JWT_SECRET="change-this-to-a-long-random-string"

# Port the Express server (API + built frontend) listens on.
PORT=4000

# On first boot, if the users table is empty, the server creates one admin account from these two
# values so there's a way to log in and create the rest of the team through the admin UI (there is no
# public self-signup). Safe to remove/ignore after that first admin exists.
ADMIN_EMAIL="admin@ziven.vn"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Quản trị viên"

# Comma-separated origins allowed to call the API with credentials, for running the Vite dev server
# separately from the API during development. Not needed in production once the API serves the built
# frontend itself from the same origin.
CORS_ORIGIN="http://localhost:5173"
