# Used by docker-compose.yml — copy to .env and fill in real values before `docker compose up`.

# Port on the HOST machine that the app is exposed on (container always listens on 4000 internally).
APP_PORT=4000

# MariaDB credentials — pick your own values, they're created fresh on first `docker compose up`.
DB_ROOT_PASSWORD="change-this-root-password"
DB_PASSWORD="change-this-app-password"

# Secret used to sign login sessions — generate with `openssl rand -hex 32`. Changing it later logs
# everyone out.
JWT_SECRET="change-this-to-a-long-random-string"

# On first boot, if there are no users yet, the server creates one admin account from these two
# values — that's the only way in, since there's no public sign-up. Log in with it once, then create
# real accounts (and consider changing this password) from the "Quản lý người dùng" admin page.
ADMIN_EMAIL="admin@ziven.vn"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Quản trị viên"

# Login cookies require HTTPS by default once deployed (see DEPLOY.md). If you're testing over plain
# http://<vps-ip>:4000 before setting up a domain + TLS, uncomment this so logins actually persist —
# remove it again (or set back to true) once you have real HTTPS in front.
# COOKIE_SECURE=false
